{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "WebSearch",
      "WebFetch",
      "mcp__github"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo archive *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh workflow disable *)",
      "Bash(gh workflow enable *)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh api --method DELETE *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin --force *)",
      "Bash(git push origin -f *)",
      "Bash(git push --delete *)",
      "Bash(git push origin --delete *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.config/**)",
      "Read(~/.cache/huggingface/**)"
    ]
  }
}

{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"GitError","description":"Why a git call failed. The text says what to do.","oneOf":[{"description":"No usable git was found.","type":"object","properties":{"Missing":{"type":"object","properties":{"found":{"description":"The version text of an older git that was found, if any.","type":["string","null"]}}}},"additionalProperties":false,"required":["Missing"]},{"description":"Git cannot be used here: this build has no git (a web build), or the installed git lacks what the call needs.","type":"string","const":"Unsupported"},{"description":"The folder is not inside a git repository.","type":"string","const":"NotARepo"},{"description":"A revision does not exist or is not a valid id.","type":"string","const":"BadRev"},{"description":"Nothing is staged or changed for the paths given.","type":"string","const":"NothingToCommit"},{"description":"A path is outside the folder or otherwise unusable.","type":"object","properties":{"BadPath":{"type":"object","properties":{"path":{"description":"The offending path.","type":"string"}},"required":["path"]}},"additionalProperties":false,"required":["BadPath"]},{"description":"Pull cannot fast-forward.","type":"object","properties":{"NotFastForward":{"type":"object","properties":{"ahead":{"description":"Commits only here.","type":"integer","format":"uint32","minimum":0},"behind":{"description":"Commits only on the remote.","type":"integer","format":"uint32","minimum":0}},"required":["ahead","behind"]}},"additionalProperties":false,"required":["NotFastForward"]},{"description":"The remote wants credentials git cannot supply without a prompt.","type":"string","const":"AuthRequired"},{"description":"A commit hook refused the commit.","type":"object","properties":{"HookRejected":{"type":"object","properties":{"output":{"description":"What the hook printed.","type":"string"}},"required":["output"]}},"additionalProperties":false,"required":["HookRejected"]},{"description":"The call ran past its timeout.","type":"string","const":"Timeout"},{"description":"The caller's [`Cancel`](crate::cancel::Cancel) was set.","type":"string","const":"Cancelled"},{"description":"Git exited with an error not covered above.","type":"object","properties":{"Failed":{"type":"object","properties":{"code":{"description":"The exit code; `None` when git was ended by a signal.","type":["integer","null"],"format":"int32"},"stderr":{"description":"What git printed to stderr.","type":"string"}},"required":["stderr"]}},"additionalProperties":false,"required":["Failed"]}]}

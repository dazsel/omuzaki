UpdateError {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"UpdateError","description":"Why an update step failed.","oneOf":[{"description":"The feed could not be reached.","type":"object","properties":{"type":{"type":"string","const":"offline"}},"required":["type"]},{"description":"The server answered with this status.","type":"object","properties":{"detail":{"type":"integer","format":"uint16","maximum":65535,"minimum":0},"type":{"type":"string","const":"http"}},"required":["type","detail"]},{"description":"The manifest expired.","type":"object","properties":{"detail":{"type":"object","properties":{"at":{"description":"The `expires` time.","$ref":"#/$defs/Timestamp"}},"required":["at"]},"type":{"type":"string","const":"expired"}},"required":["type","detail"]},{"description":"The manifest is older than one already seen.","type":"object","properties":{"detail":{"type":"object","properties":{"got":{"description":"The manifest's.","$ref":"#/$defs/Watermark"},"have":{"description":"The stored watermark.","$ref":"#/$defs/Watermark"}},"required":["have","got"]},"type":{"type":"string","const":"replay"}},"required":["type","detail"]},{"description":"A signature did not verify.","type":"object","properties":{"detail":{"type":"object","properties":{"key_id":{"description":"The signing key's id.","type":"string"}},"required":["key_id"]},"type":{"type":"string","const":"bad_signature"}},"required":["type","detail"]},{"description":"The signing key is not in the app.","type":"object","properties":{"type":{"type":"string","const":"unknown_key"}},"required":["type"]},{"description":"A file's hash differs from the manifest's.","type":"object","properties":{"detail":{"type":"object","properties":{"file":{"description":"The file.","type":"string"}},"required":["file"]},"type":{"type":"string","const":"hash_mismatch"}},"required":["type","detail"]},{"description":"A download or file passed its size cap.","type":"object","properties":{"type":{"type":"string","const"
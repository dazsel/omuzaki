UpdateStatus {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"UpdateStatus","description":"Where the update flow stands.","oneOf":[{"description":"Updates are off for this install.","type":"object","properties":{"reason":{"description":"Why.","$ref":"#/$defs/Unavailable"},"type":{"type":"string","const":"unavailable"}},"required":["type","reason"]},{"description":"Nothing to do.","type":"object","properties":{"last_checked":{"description":"When the last check finished.","anyOf":[{"$ref":"#/$defs/Timestamp"},{"type":"null"}]},"type":{"type":"string","const":"idle"}},"required":["type"]},{"description":"A newer version is offered.","type":"object","properties":{"release":{"description":"The offer.","$ref":"#/$defs/Release"},"type":{"type":"string","const":"available"}},"required":["type","release"]},{"description":"A package is downloading.","type":"object","properties":{"percent":{"description":"0 to 100.","type":"integer","format":"uint8","maximum":255,"minimum":0},"type":{"type":"string","const":"downloading"},"version":{"description":"The version being fetched.","$ref":"#/$defs/SemVer"}},"required":["type","version","percent"]},{"description":"Verified and unpacked; applied at the next start.","type":"object","properties":{"deferred_by":{"description":"Holds that would stop a restart now.","type":"array","items":{"$ref":"#/$defs/HoldReason"}},"type":{"type":"string","const":"staged"},"version":{"description":"The staged version.","$ref":"#/$defs/SemVer"}},"required":["type","version","deferred_by"]},{"description":"The last explicit check failed.","type":"object","properties":{"at":{"description":"When.","$ref":"#/$defs/Timestamp"},"reason":{"description":"Why.","$ref":"#/$defs/CheckFailure"},"type":{"type":"string","const":"check_failed"}},"required":["type","at","reason"]},{"description":"The launcher or the person moved back to the previous version. Shown once.","type":"object","properties":{"from":{"description":"The version that was left.","
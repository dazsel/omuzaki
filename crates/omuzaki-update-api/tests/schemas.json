o download.","type":"integer","format":"uint64","minimum":0},"installed_bytes":{"description":"Bytes on disk once installed.","type":"integer","format":"uint64","minimum":0},"notes_url":{"description":"An optional page of release notes.","anyOf":[{"$ref":"#/$defs/Url"},{"type":"null"}]},"package":{"description":"Delta or full.","$ref":"#/$defs/PackageKind"},"recommended":{"description":"True when the running version is below the manifest's `yanked_below`: a stronger \"update recommended\".","type":"boolean"},"sequence":{"description":"The manifest's monotonic sequence.","type":"integer","format":"uint64","minimum":0},"version":{"description":"The version offered.","$ref":"#/$defs/SemVer"}},"required":["version","channel","sequence","package","download_bytes","installed_bytes","recommended"]},"RollbackReason":{"description":"Why a version was rolled back.","oneOf":[{"description":"The launcher's boot guard: the version died twice before the UI was ready.","type":"string","const":"failed_to_start_twice"},{"description":"The person asked.","type":"string","const":"manual"}]},"SemVer":{"type":"string","pattern":"^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"},"Timestamp":{"description":"Unix seconds, UTC.","type":"integer","format":"int64"},"Unavailable":{"description":"Why updates are off.","oneOf":[{"description":"A package manager owns the install.","type":"string","const":"managed"},{"description":"The install root cannot be written.","type":"string","const":"read_only_root"},{"description":"A debug or development build.","type":"string","const":"dev_build"}]},"Url":{"description":"An https URL. Used for release-notes pages only.\n\nThe only way in is [`Url::new`], and deserialization goes through it too, so a `Url` value is always: an `https://`\nURL (the scheme in any case) with a non-empty ASCII host made of letters, digits, `-` and `.` (no leading or trailing\ndot), an optional numeric port from 1 to 65535, no user information, and no spaces, control or non-ASCII characters.\nA host made only of digits and dots must be a valid dotted-quad IPv4 address (`std::net::Ipv4Addr`), so `256.0.0.1`\nand `9999999999999` are rejected; `127.0.0.1` is accepted, because the contract has no network policy. A manifest\nthat offers `http:`, `file:` or a non-URL fails to parse as a whole.\n\nThis is a syntax check and nothing more. It does not guarantee that the host resolves, that the page exists, or that\na browser would open the text as written (hex and octal host forms, IDN and the like are not modelled). The app\nopens the URL through the operating system's handler, which does its own parsing.","type":"string"}}}

*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"},"Timestamp":{"description":"Unix seconds, UTC.","type":"integer","format":"int64"},"Unavailable":{"description":"Why updates are off.","oneOf":[{"description":"A package manager owns the install.","type":"string","const":"managed"},{"description":"The install root cannot be written.","type":"string","const":"read_only_root"},{"description":"A debug or development build.","type":"string","const":"dev_build"}]},"Watermark":{"description":"How far a feed has gone: ordered as the pair, `epoch` first (design section 4), so a key rotation that bumps the\nepoch outranks any sequence of the old one.","type":"object","properties":{"epoch":{"description":"The key epoch.","type":"integer","format":"uint32","minimum":0},"sequence":{"description":"The manifest sequence within the epoch.","type":"integer","format":"uint64","minimum":0}},"required":["epoch","sequence"]}}}
State {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"State","description":"The install state.","type":"object","properties":{"attempts":{"description":"Trial starts that ended before `healthy`.","type":"integer","format":"uint8","default":0,"maximum":255,"minimum":0},"bad":{"description":"Versions that failed and are not offered again.","type":"array","default":[],"items":{"$ref":"#/$defs/SemVer"}},"current":{"description":"The version the launcher starts.","$ref":"#/$defs/SemVer"},"keys_sequence":{"description":"The sequence of the embedded-keys list last accepted.","type":"integer","format":"uint64","default":0,"minimum":0},"last_checked":{"description":"When the last check finished.","anyOf":[{"$ref":"#/$defs/Timestamp"},{"type":"null"}],"default":null},"pending":{"description":"A staged version the launcher switches to at its next start.","anyOf":[{"$ref":"#/$defs/SemVer"},{"type":"null"}],"default":null},"previous":{"description":"The version before it; the rollback target.","anyOf":[{"$ref":"#/$defs/SemVer"},{"type":"null"}],"default":null},"rolled_back_from":{"description":"Set by an automatic or manual rollback; shown once.","type":["array","null"],"default":null,"maxItems":2,"minItems":2,"prefixItems":[{"$ref":"#/$defs/SemVer"},{"$ref":"#/$defs/RollbackReason"}]},"trial":{"description":"Whether `current` is still on trial.","type":"boolean","default":false},"watermarks":{"description":"Per feed: `stable`, `beta`, `catalogue`.","type":"object","additionalProperties":{"$ref":"#/$defs/Watermark"},"default":{}}},"required":["current"],"$defs":{"RollbackReason":{"description":"Why a version was rolled back.","oneOf":[{"description":"The launcher's boot guard: the version died twice before the UI was ready.","type":"string","const":"failed_to_start_twice"},{"description":"The person asked.","type":"string","const":"manual"}]},"SemVer":{"type":"string","pattern":"^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-